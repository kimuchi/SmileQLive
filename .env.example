# =============================================================================
# SmileQ Live 環境変数サンプル
# 実値を含む .env.local はコミットしないこと。
# Cloud Run では NEXT_PUBLIC_* によるビルド時埋め込みを使わず、
# すべて実行時環境変数として読み込む（同一イメージを staging / production で再利用する）。
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase の公開設定
#
# ブラウザへ渡してよい値です（Server Component 経由で RuntimeConfig へ渡します）。
# apiKey は「公開前提の識別子」であって秘密鍵ではありません。
# 実際の保護は Security Rules とサーバー側の認可で行います（docs/FIRESTORE_MODEL.md §6）。
#
# 値は Firebase コンソール →「プロジェクトの設定」→ マイアプリ（ウェブアプリ）で確認できます。
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# 任意。Analytics を使わないため未設定でも動きます。
FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# サーバー専用の秘密情報は「ありません」
#
# Firestore / Auth / Storage への認証は、Cloud Run 実行サービスアカウントの
# ADC（Application Default Credentials）で行います。Secret Manager も秘密鍵ファイルも不要です。
#
# ローカル開発では次のどちらかで ADC を用意します。
#   gcloud auth application-default login          ← 推奨
#   （または）Firebase エミュレータを使う: npm run emulators
#
# サービスアカウントの JSON 鍵はリポジトリへ置かないでください。
# -----------------------------------------------------------------------------

# エミュレータへ向ける場合だけ設定する（本番では絶対に設定しないこと）。
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# -----------------------------------------------------------------------------
# 司会ログインの制限（任意）
#
# 管理画面へログインできるメールドメインをカンマ区切りで指定します。
# **未設定ならドメイン制限なし。** その場合でも、管理画面を使えるのは
# profiles/{uid} が存在する利用者だけです（docs/HOST_ACCESS.md）。
# -----------------------------------------------------------------------------
ALLOWED_AUTH_DOMAINS=

# -----------------------------------------------------------------------------
# アプリ設定
# -----------------------------------------------------------------------------
# 本番・ステージングでは正式な HTTPS URL を設定する（カスタムドメイン運用時は必須）。
APP_BASE_URL=http://localhost:3000
# クイズ画像を置く Cloud Storage バケット。未設定なら FIREBASE_STORAGE_BUCKET を使う。
MEDIA_BUCKET=
PRESENTATION_LINK_TTL_MINUTES=480
JOIN_TOKEN_BYTES=16
LOG_LEVEL=info
APP_ENV=local

# -----------------------------------------------------------------------------
# ローカル専用。Cloud Run では PORT が自動注入されるため設定しないこと。
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# 任意: 参加登録の CAPTCHA (Cloudflare Turnstile)。未設定なら CAPTCHA 無効。
# TURNSTILE_SECRET_KEY だけは秘密情報なので、Cloud Run では Secret Manager から注入する。
# -----------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 任意: E2E / ローカル検証用
# -----------------------------------------------------------------------------
E2E_BASE_URL=
