rules_version = '2';

// =============================================================================
// SmileQ Live — Cloud Storage Security Rules
// =============================================================================
// 方針:
//   * アップロード・削除は Cloud Run（Admin SDK）経由のみ。クライアント書き込みは全拒否。
//   * 画像は WebP へ変換済みのものだけが置かれる。
//   * 読み取りは署名付き URL を経由させるため、クライアントの直接読み取りも拒否する。
//     （正解・解説画像の URL は、正解発表まで API から返さない設計と揃える）
//   * ファイル名に correct / answer 等の正解を推測できる語を含めない
//     （命名はサーバー側 buildObjectPath() が担保する）。
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
