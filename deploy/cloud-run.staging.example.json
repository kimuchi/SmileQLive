  "serviceAccount": "smileq-live-runtime@your-gcp-project-id.iam.gserviceaccount.com",

  "customDomain": "",
  "domainMode": "domain-mapping",
  "appBaseUrl": "",

  "firebaseProjectId": "your-firebase-staging-project",
  "firebaseApiKey": "AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
