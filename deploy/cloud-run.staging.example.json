  "firebaseStorageBucket": "your-firebase-staging-project.firebasestorage.app",
  "firebaseAppId": "1:000000000000:web:0000000000000000000000",

  "allowedAuthDomains": [],

  "mediaBucket": "your-firebase-staging-project.firebasestorage.app",
  "presentationLinkTtlMinutes": 480,

  "minInstances": 0,
  "maxInstances": 5,
  "concurrency": 80,
  "cpu": "1",
  "memory": "1Gi",
