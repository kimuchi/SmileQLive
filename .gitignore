# dependencies
node_modules/
.pnp
.pnp.*
# このリポジトリは pnpm を正とする（package.json の packageManager）。
# npm install で生成される package-lock.json は成果物として扱わない
# （2 つのロックファイルが食い違うのを避け、デプロイ前のクリーン判定も汚さない）。
package-lock.json

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# env files (実値)
.env
.env.local
.env.*.local
.env.development
.env.production

# 実値を含むデプロイ設定 (example のみコミットする)
deploy/cloud-run.staging.json
deploy/cloud-run.production.json
deploy/cloud-run.*.json
!deploy/cloud-run.*.example.json

# supabase local
supabase/.temp/
supabase/.branches/

# 効果音の差し替え置き場。
# public/sounds/ 直下は外部素材（効果音ラボなど再配布禁止のもの）を入れる場所なのでコミットしない。
# 同梱音は public/sounds/default/ にあり、こちらは自家生成のため追跡対象。
# 取得方法は public/sounds/README.md / npm run sounds:install を参照
/public/sounds/*.mp3
/public/sounds/*.wav
/public/sounds/*.ogg

# misc
.DS_Store
*.pem
.vercel
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json

# firebase CLI の作業ディレクトリ
.firebase/
# rules:deploy が生成する配信用の一時設定（対象データベースとバケットを確定させる）
.smileq-deploy.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
